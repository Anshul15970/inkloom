# Inkloom AI Brand Governance Platform - Backend Environment Template

PROJECT_NAME=Inkloom
ENVIRONMENT=development

# Database Settings
# For local PostgreSQL with pgvector:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=inkloom_db

# Security & Authentication
# Generate a secure secret using: openssl rand -hex 32
SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# AI Provider Configuration (Google Gemini)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
